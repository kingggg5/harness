{
	"schema_version": 1,
	"graph_id": "saved-filters-feature",
	"project_id": "project-00000000-0000-0000-0000-000000000000",
	"run_id": "RUN-example",
	"coordinator": "Project Manager",
	"isolation_strategy": "git-worktree",
	"base_revision": "0000000000000000000000000000000000000000",
	"max_parallel": 2,
	"max_transitions": 24,
	"entry_nodes": ["plan"],
	"nodes": [
		{
			"id": "plan",
			"kind": "model",
			"owner": "Planner / Architect",
			"objective": "Stabilize the saved-filter contract and split only independent client and server work.",
			"inputs": ["request", "repository-evidence"],
			"optional_inputs": [],
			"outputs": ["plan-candidate"],
			"read_scope": ["."],
			"write_scope": [],
			"max_attempts": 2,
			"timeout_seconds": 900,
			"side_effect": "none",
			"success_criteria": ["API, UX states, ownership, test contract, and rollout boundaries are explicit."]
		},
		{
			"id": "plan-approval",
			"kind": "human",
			"owner": "Human",
			"objective": "Approve or revise the material plan before implementation.",
			"inputs": ["plan-candidate"],
			"optional_inputs": [],
			"outputs": ["approved-contract"],
			"read_scope": ["."],
			"write_scope": [],
			"max_attempts": 1,
			"timeout_seconds": 3600,
			"side_effect": "none",
			"success_criteria": ["The human explicitly approves the scope and contracts."]
		},
		{
			"id": "frontend",
			"kind": "model",
			"owner": "Frontend Engineer",
			"objective": "Implement saved-filter UI states against the approved contract.",
			"inputs": ["approved-contract"],
			"optional_inputs": [],
			"outputs": ["frontend-change"],
			"read_scope": ["src/client", "tests/client"],
			"write_scope": ["src/client", "tests/client"],
			"max_attempts": 2,
			"timeout_seconds": 1800,
			"side_effect": "reversible",
			"success_criteria": ["Loading, empty, success, error, keyboard, and responsive states pass focused checks."]
		},
		{
			"id": "backend",
			"kind": "model",
			"owner": "Backend Engineer",
			"objective": "Implement persistence and authorization against the approved contract.",
			"inputs": ["approved-contract"],
			"optional_inputs": [],
			"outputs": ["backend-change"],
			"read_scope": ["src/server", "tests/server"],
			"write_scope": ["src/server", "tests/server"],
			"max_attempts": 2,
			"timeout_seconds": 1800,
			"side_effect": "reversible",
			"success_criteria": ["Validation, authorization, concurrency, and negative tests pass."]
		},
		{
			"id": "merge",
			"kind": "merge",
			"owner": "Project Manager",
			"objective": "Integrate the two owned changes without weakening either contract.",
			"inputs": ["frontend-change", "backend-change"],
			"optional_inputs": [],
			"outputs": ["integrated-change"],
			"read_scope": ["."],
			"write_scope": ["src/integration", "tests/integration"],
			"max_attempts": 2,
			"timeout_seconds": 1200,
			"side_effect": "reversible",
			"success_criteria": ["The integrated change satisfies both contracts and has one merge owner."],
			"join": "all"
		},
		{
			"id": "qa",
			"kind": "deterministic",
			"owner": "Tester / Reviewer / QA",
			"objective": "Run the acceptance matrix and classify failures without editing production code.",
			"inputs": ["integrated-change"],
			"optional_inputs": ["repair-set"],
			"outputs": ["qa-report", "qa-findings"],
			"read_scope": ["."],
			"write_scope": [],
			"max_attempts": 1,
			"timeout_seconds": 1800,
			"side_effect": "none",
			"success_criteria": ["Acceptance, regression, security, accessibility, and performance checks have truthful evidence."]
		},
		{
			"id": "repair",
			"kind": "model",
			"owner": "Project Manager",
			"objective": "Route classified QA findings to the one owner of each affected file and produce a bounded repair set.",
			"inputs": ["qa-findings"],
			"optional_inputs": [],
			"outputs": ["repair-set"],
			"read_scope": ["."],
			"write_scope": ["src/client", "tests/client", "src/server", "tests/server", "src/integration", "tests/integration"],
			"max_attempts": 2,
			"timeout_seconds": 1800,
			"side_effect": "reversible",
			"success_criteria": ["Every repair maps to a classified finding and preserves the approved contract."]
		},
		{
			"id": "acceptance",
			"kind": "human",
			"owner": "Human",
			"objective": "Review evidence, residual risk, and limitations before publication.",
			"inputs": ["qa-report"],
			"optional_inputs": [],
			"outputs": ["accepted-result"],
			"read_scope": ["."],
			"write_scope": [],
			"max_attempts": 1,
			"timeout_seconds": 3600,
			"side_effect": "none",
			"success_criteria": ["The human explicitly accepts the evidence and residual risk."]
		},
		{
			"id": "publish",
			"kind": "deterministic",
			"owner": "Project Manager",
			"objective": "Publish only the exact human-accepted result through an authorized backend.",
			"inputs": ["accepted-result"],
			"optional_inputs": [],
			"outputs": ["publication-receipt"],
			"read_scope": ["."],
			"write_scope": [],
			"max_attempts": 1,
			"timeout_seconds": 900,
			"side_effect": "consequential",
			"idempotency_key": "RUN-example:publish:accepted-result",
			"success_criteria": ["The external receipt matches the approved version and target."]
		}
	],
	"edges": [
		{"from": "plan", "to": "plan-approval", "type": "data", "condition": "on_success", "consumes": ["plan-candidate"]},
		{"from": "plan-approval", "to": "frontend", "type": "data", "condition": "on_approve", "consumes": ["approved-contract"]},
		{"from": "plan-approval", "to": "backend", "type": "data", "condition": "on_approve", "consumes": ["approved-contract"]},
		{"from": "frontend", "to": "merge", "type": "data", "condition": "on_success", "consumes": ["frontend-change"]},
		{"from": "backend", "to": "merge", "type": "data", "condition": "on_success", "consumes": ["backend-change"]},
		{"from": "merge", "to": "qa", "type": "data", "condition": "on_success", "consumes": ["integrated-change"]},
		{"from": "qa", "to": "repair", "type": "data", "condition": "on_failure", "consumes": ["qa-findings"]},
		{"from": "repair", "to": "qa", "type": "loop", "condition": "on_success", "consumes": ["repair-set"], "max_rounds": 2},
		{"from": "qa", "to": "acceptance", "type": "data", "condition": "on_success", "consumes": ["qa-report"]},
		{"from": "acceptance", "to": "publish", "type": "data", "condition": "on_approve", "consumes": ["accepted-result"]},
		{"from": "acceptance", "to": "publish", "type": "control", "condition": "on_approve", "consumes": []}
	]
}
