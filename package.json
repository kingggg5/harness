{
	"name": "@kingggg5/harness",
	"version": "0.4.1",
	"description": "Adaptive software-delivery harness for Codex, Claude Code, Gemini CLI, and filesystem-capable agents: model/effort routing, seven delivery roles, conditional business analysis, durable scoped memory, and human gates.",
	"license": "MIT",
	"homepage": "https://github.com/kingggg5/harness#readme",
	"bugs": {
		"url": "https://github.com/kingggg5/harness/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingggg5/harness.git"
	},
	"keywords": [
		"ai-agents",
		"claude-code",
		"codex",
		"gemini-cli",
		"harness",
		"project-memory",
		"skills"
	],
	"bin": {
		"harness": "bin/harness.js"
	},
	"scripts": {
		"test": "npm run test:portability && npm run test:race && npm run test:memory",
		"test:portability": "python skills/best-in-code/scripts/validate_portability.py",
		"test:race": "python skills/best-in-code/scripts/race_tests.py",
		"test:memory": "python skills/best-in-code/scripts/run_memory_evals.py",
		"pack:check": "node scripts/verify-package.mjs"
	},
	"files": [
		"bin/",
		"skills/",
		"adapters/",
		"assets/",
		"examples/",
		".claude-plugin/",
		".codex-plugin/",
		"gemini-extension.json",
		"README.md",
		"RELEASING.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18"
	},
	"dependencies": {}
}
