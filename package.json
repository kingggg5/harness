{
	"name": "@kingggg5/harness",
	"version": "0.6.0",
	"description": "Provider-neutral software-delivery harness with executable multi-agent graphs, bounded context, durable memory, behavioral evals, trusted tool policy, and human gates.",
	"license": "MIT",
	"homepage": "https://github.com/kingggg5/harness#readme",
	"bugs": {
		"url": "https://github.com/kingggg5/harness/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingggg5/harness.git"
	},
	"keywords": [
		"ai-agents",
		"claude-code",
		"codex",
		"gemini-cli",
		"harness",
		"loop-engineering",
		"graph-engineering",
		"graph-runtime",
		"git-worktree",
		"project-memory",
		"skills"
	],
	"bin": {
		"harness": "bin/harness.js"
	},
	"scripts": {
		"test": "npm run test:portability && npm run test:launcher && npm run test:ci-policy && npm run test:runtime-pin && npm run test:execution && npm run test:context-eval-trace && npm run test:loop && npm run test:loop-runtime && npm run test:graph && npm run test:graph-runtime && npm run test:race && npm run test:memory && npm run test:sbom && npm run test:portability",
		"test:portability": "python -B skills/best-in-code/scripts/validate_portability.py",
		"test:launcher": "node scripts/launcher_tests.mjs",
		"test:ci-policy": "python -B scripts/check_eval_results_tests.py",
		"test:runtime-pin": "python -B skills/best-in-code/scripts/doctor_runtime_tests.py",
		"test:execution": "python -B skills/best-in-code/scripts/execution_runtime_tests.py",
		"test:context-eval-trace": "python -B skills/best-in-code/scripts/context_eval_trace_tests.py",
		"test:loop": "python -B skills/best-in-code/scripts/loop_tests.py",
		"test:loop-runtime": "python -B skills/best-in-code/scripts/loop_runtime_tests.py",
		"test:graph": "python -B skills/best-in-code/scripts/graph_tests.py",
		"test:graph-runtime": "python -B skills/best-in-code/scripts/graph_runtime_tests.py",
		"test:race": "python -B skills/best-in-code/scripts/race_tests.py",
		"test:memory": "python -B skills/best-in-code/scripts/run_memory_evals.py",
		"test:sbom": "node scripts/generate-sbom-tests.mjs",
		"sbom:generate": "node scripts/generate-sbom.mjs",
		"pack:check": "node scripts/verify-package.mjs"
	},
	"files": [
		"bin/",
		"skills/",
		"adapters/",
		"assets/",
		"examples/",
		"scripts/check_eval_results.py",
		"scripts/check_eval_results_tests.py",
		"scripts/generate-sbom.mjs",
		"scripts/generate-sbom-tests.mjs",
		"scripts/launcher_tests.mjs",
		"scripts/verify-package.mjs",
		".claude-plugin/",
		".codex-plugin/",
		"gemini-extension.json",
		"README.md",
		"RELEASING.md",
		"SECURITY.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18"
	},
	"dependencies": {}
}
